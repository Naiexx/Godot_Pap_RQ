do Global.randomizaPergunta() #Vai trocar o pergunta_random para outro número aleatorio
César Augusto: Olá tenho uma pergunta para ti, caso acertes recebes uma tarefa
César Augusto: {{Global.perguntas[Global.pergunta_random]}} 
- Verdadeiro.  
	if Global.respostas[Global.pergunta_random] == "v": 
		César Augusto: Acertaste!! 
		César Augusto: Vai ao quadro de tarefas para ver a tarefa recebida
		do Global.adicionarTarefa() # adiciona uma tarefa ao quadro de tarefas
		do Global.stats_respostas_certas = Global.stats_respostas_certas + 1
		
	else:
		César Augusto: Erraste!!
		do Global.carregarCena()
		do Global._move_speed = 150
		do Global.stats_respostas_erradas = Global.stats_respostas_erradas + 1
